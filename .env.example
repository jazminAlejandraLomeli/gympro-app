# ------------------------------------------------------------------
# Base de datos – servicio RENTADO / administrado (externo, no Docker)
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=tu-host-rentado.ejemplo.com
DB_PORT=3306
DB_DATABASE=gympro
DB_USERNAME=gympro_user
DB_PASSWORD=
# Si tu proveedor exige SSL, descomenta y apunta al certificado CA:
# MYSQL_ATTR_SSL_CA=/ruta/al/ca.pem

# ------------------------------------------------------------------
# Redis – contenedor local (docker-compose.yml)
# ------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esta-clave-redis
REDIS_MAXMEMORY=512mb

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------
# Meilisearch – contenedor local (Laravel Scout)
# ------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
# Mínimo 16 caracteres (obligatorio cuando MEILI_ENV=production)
MEILISEARCH_KEY=cambia-esta-master-key-meili
MEILISEARCH_PORT=7700
MEILI_ENV=development
