APP_NAME=GymPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Cada gimnasio: {slug}.APP_BASE_DOMAIN  (local: irondemo.localhost:8000)
APP_BASE_DOMAIN=localhost
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Base de datos – servicio RENTADO / administrado (externo, no Docker)
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=tu-host-rentado.ejemplo.com
DB_PORT=3306
DB_DATABASE=gympro
DB_USERNAME=gympro_user
DB_PASSWORD=
# Si tu proveedor exige SSL, descomenta y apunta al certificado CA:
# MYSQL_ATTR_SSL_CA=/ruta/al/ca.pem

# ------------------------------------------------------------------
# Redis – contenedor local (docker-compose.yml)
# predis = cliente PHP puro (no requiere la extensión phpredis)
# ------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esta-clave-redis
REDIS_MAXMEMORY=512mb

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------
# Meilisearch – contenedor local (Laravel Scout)
# ------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
# Indexa en segundo plano vía la cola de Redis
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
# Mínimo 16 caracteres (obligatorio cuando MEILI_ENV=production)
MEILISEARCH_KEY=cambia-esta-master-key-meili
MEILISEARCH_PORT=7700
MEILI_ENV=development

# FFmpeg para comprimir clips (Módulo B)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
